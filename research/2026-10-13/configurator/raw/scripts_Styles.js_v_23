gle-button {\n    -webkit-tap-highlight-color: rgba(0,0,0,0);\n    -webkit-touch-callout: none;\n    user-select: none;\n    -webkit-user-select: none;\n    -moz-user-select: none;\n    -ms-user-select: none;\n}\n.range-info {\n    height: var(--footerPanelHeightMobile);\n    padding-top: 10px;\n    padding-bottom: 10px;\n}\n.footer-main-menu {\n    margin-left: 150px;\n    margin-right: 50px;\n}\n.footer-main-menu__buttons {\n    max-width: initial;\n}\n}\n@media (max-width: 767.98px) {\n  /* Small devices */\n.range-info {\n    display: none;\n}\n.footer-main-menu {\n    margin-left: 50px;\n}\n}\n@media (max-width: 500px) {\n.footer-main-menu {\n    margin-left: var(--footerMenuMargin);\n    margin-right: var(--footerMenuMargin);\n}\n}',""]);const l=a;e.d(t,["A",0,l])},72(n,t,e){var o=e(31601),r=e.n(o),i=e(76314),a=e.n(i)()(r());a.push([n.id,"@import url(https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap);"]),a.push([n.id,'/* Fonts */\n\n* {\n  box-sizing: border-box;\n}\n\n.disabled {\n  cursor: not-allowed;\n}\n.disabled label,\n.disabled input,\n.disabled button,\n.disabled .sidebar-tab-collapse-btn,\n.disabled select {\n  pointer-events: none;\n  opacity: 0.5;\n}\n.disabled button,\n.disabled label {\n  filter: grayscale(100%);\n}\n\nbody {\n  font-family: "Barlow Condensed", sans-serif;\n  color: #000000;\n  font-weight: 400;\n  font-style: normal;\n  font-size: 17px;\n  line-height: 26px;\n  background-color: var(--headerBackground);\n  overflow-x: hidden;\n}\n@media (max-width: 991.98px) {\n  /* Small devices */\n  body {\n    font-size: 15px;\n    line-height: 23.13px;\n  }\n  html, body, .panels {\n    height: 100%;\n  }\n}\n\n/* Header */\n.header {\n  position: fixed;\n  top: 0;\n  left: var(--sidebarWidth);\n  z-index: 1;\n  background: var(--headerBackground);\n}\n@media (max-width: 991.98px) {\n  /* Small devices */\n  .header {\n    bottom: auto;\n    left: 0;\n    z-index: 11;\n  }\n}\n\n/* Logo with text description */\n.logo-panel {\n  height: var(--logoPanelHeight);\n  padding: 10px 0 10px 30px;\n  z-index: 1;\n  color: var(--headerColor);\n  font-weight: 600;\n  text-decoration: none;\n  max-width: calc(min(300px, 50vw));\n  overflow: hidden;\n  display: flex;\n  align-items: center;\n  float: left;\n}\n@media (max-width: 767.98px) {\n  .logo-panel {\n    display: var(--logoPanelDisplayMobile);\n  }\n}\n.logo-panel img {\n  width: auto;\n  max-width: 100%;\n  height: 100%;\n  object-fit: contain;\n  display: block;\n}\n.logo-panel img[src=""] {\n   display: none;\n}\n.logo-panel p {\n    margin: 3px 0 0 7px;\n    font-size: 15px;\n    line-height: 1.2;\n}\n\n.header__button-wrapper {\n  padding: 10px 0;\n  height: var(--headerPanelHeight);\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: space-evenly;\n}\n.header__button-wrapper > button {\n  cursor: pointer;\n  background: none;\n  border: none;\n  outline: none;\n  text-transform: uppercase;\n}\n.header__button-wrapper > button.active {\n  color: #62901a;\n  text-decoration: underline;\n}\n@media (max-width: 1200px) {\n  .header__button-wrapper > button {\n    margin: 0 20px;\n  }\n}\n@media (max-width: 900px) {\n  .header__button-wrapper {\n    text-align: right;\n    margin: 0 40px;\n  }\n}\n@media (max-width: 991.98px) {\n  /* Small devices */\n  .header__button-wrapper > button {\n    font-size: 15px;\n    margin: 0 10px;\n  }\n  .logo-panel {\n    padding-left: 20px;\n  }\n}\n@media (max-width: 709px) {\n  .header__button-wrapper {\n    margin: 0 20px;\n  }\n}\n@media (max-width: 610px) {\n  .logo-panel {\n    left: 20px;\n  }\n  .header__button-wrapper {\n    margin: 0 10px;\n    display: flex;\n    flex-wrap: wrap;\n    align-content: center;\n    justify-content: center\n  }\n  .header__button-wrapper > button {\n    margin: 0px;\n  }\n}\n\n/* panels */\n.panels {\n  position: fixed;\n  left: 0;\n  right: 0;\n  top: 0;\n  bottom: 0;\n}\n@media (max-width: 991.98px) {\n  /* Small devices */\n  .panels {\n    position: static;\n  }\n}\n\n/* main-panel */\n.main-panel {\n  position: absolute;\n  right: 0;\n  top: 0;\n  bottom: var(--footerPanelHeight);\n  width: calc(100% - var(--sidebarWidth));\n  background: #f0f0f0;\n  overflow: hidden;\n}\n/* iframe */\n#canvas-container {\n  width: 100%;\n  height: 100%;\n  border: 0;\n}\n\n@media (max-width: 991.98px) {\n  /* Small devices */\n  .main-panel {\n    position: fixed;\n    left: auto;\n    bottom: auto;\n    width: 100%;\n    height: calc(var(--mainPanelMobileHeight) + var(--headerPanelHeight));\n    padding-bottom: 0;\n    z-index: 10;\n  }\n}\n.main-panel::-webkit-scrollbar {\n  width: 7.5px;\n  height: 7.5px;\n}\n.main-panel::-webkit-scrollbar-track {\n  background: transparent;\n}\n.main-panel::-webkit-scrollbar-thumb {\n  background: #999999;\n}\n.main-panel::-webkit-scrollbar-thumb:hover {\n  background: #666666;\n}\n.header-toolbar-light {\n  z-index: 14;\n}\n\n/* full-screen on body tag */\n.main-panel--fullscreen {\n  overflow: hidden;\n}\n.main-panel--fullscreen .header {\n  left: 0;\n  z-index: 13;\n}\n.main-panel--fullscreen .panels {\n  z-index: 12;\n}\n.main-panel--fullscreen .main-panel {\n  position: fixed;\n  z-index: 12;\n  left: 0;\n  right: 0;\n  top: 0;\n  bottom: 0;\n  width: 100%;\n  height: 100%;\n}\n.main-panel--fullscreen .main-panel__toggle-btn {\n  border: none;\n  background-color: transparent !important;\n}\n@media (max-width: 991.98px) {\n  .header-toolbar-light .main-panel__toggle-btn  {\n    position: fixed;\n    top: calc(var(--mainPanelMobileHeight) + 3px);\n    right: 3px;\n    background-color: transparent !important;\n  }\n  .main-panel--fullscreen .main-panel__toggle-btn {\n    top: initial;\n    bottom: 6px;\n  }\n}\n\n/* side-bar */\n.side-bar {\n  position: absolute;\n  left: 0;\n  top: 0;\n  bottom: var(--footerPanelHeight);\n  width: var(--sidebarWidth);\n  color: var(--panelColor);\n  background: var(--panelBackground);\n  background-image: var(--panelBackgroundImage);\n}\n.side-bar > .animated-scrolldown {\n  display: none;\n}\n.side-bar.overflown > .animated-scrolldown {\n  display: block;\n}\n.side-bar .sidebar-tabs-container {\n  height: calc(100% - 66px);\n  overflow-x: hidden;\n  overflow-y: auto;\n  background:\n    linear-gradient(\n      var(--panelBackground) 30%,\n      rgba(255, 255, 255, 0)\n    ) center top,\n    linear-gradient(\n      rgba(255, 255, 255, 0),\n      var(--panelBackground) 70%\n    ) center bottom,\n    radial-gradient(\n      farthest-side at 50% 0,\n      rgba(0, 0, 0, 0.2),\n      rgba(0, 0, 0, 0)\n    ) center top,\n    radial-gradient(\n      farthest-side at 50% 100%,\n      rgba(0, 0, 0, 0.2),\n      rgba(0, 0, 0, 0)\n    ) center bottom;\n  background-repeat: no-repeat;\n  background-size: 100% 40px, 100% 40px, 100% 14px, 100% 14px;\n  background-attachment: local, local, scroll, scroll;\n}\n.side-bar .sidebar-tabs-container::-webkit-scrollbar {\n  display: none;\n}\n.side-bar .sidebar-tabs-container {\n  -ms-overflow-style: none;\n  scrollbar-width: none;\n}\n@media (max-width: 991.98px) {\n  /* Small devices */\n  .side-bar {\n    top: calc(var(--headerPanelHeight) + var(--mainPanelMobileHeight));\n    bottom: var(--footerPanelHeightMobile);\n    width: 100%;\n  }\n  .side-bar-container {\n    padding: 15px;\n  }\n  .side-bar .sidebar-tabs-container {\n    height: 100%;\n  }\n}\n\n.side-bar .sidebar-tabs-container::-webkit-scrollbar {\n  width: 5px;\n  height: 7.5px;\n}\n.side-bar .sidebar-tabs-container::-webkit-scrollbar-track {\n  background: #dddddd;\n}\n.side-bar .sidebar-tabs-container::-webkit-scrollbar-thumb {\n  background: rgba(0, 0, 0, 1);\n}\n.side-bar .sidebar-tabs-container::-webkit-scrollbar-thumb:hover {\n  background: rgba(0, 0, 0, 1);\n}\n\n/* controls-size */\n.controls-size {\n  margin-bottom: 25px;\n}\n.controls-size p:first-child {\n  text-align: center;\n  margin-top: 0;\n}\n.controls-size > div {\n  display: flex;\n  justify-content: center;\n  align-items: center;\n}\n.controls-size__left {\n  display: inline-block;\n  position: relative;\n  height: 38px;\n  width: 30px;\n  background: none;\n  outline: none;\n  cursor: pointer;\n  box-shadow: none;\n  border: none;\n  margin-right: 10px;\n}\n@media (max-width: 1199.98px) {\n  .controls-size__left {\n    margin-right: 0px;\n  }\n}\n.controls-size__left::after {\n  position: absolute;\n  left: 50%;\n  top: 50%;\n  transform: translate3d(-50%, -50%, 0) rotate(90deg);\n  content: "";\n  width: 24px;\n  height: 24px;\n  background-color: var(--sizeSelectorColor);\n  -webkit-mask: url(content/images/caret.svg) no-repeat center;\n  mask: url(content/images/caret.svg) no-repeat center center;\n}\n.controls-size__right {\n  display: inline-block;\n  position: relative;\n  height: 38px;\n  width: 30px;\n  background: none;\n  outline: none;\n  cursor: pointer;\n  box-shadow: none;\n  border: none;\n  margin-left: 10px;\n}\n@media (max-width: 1199.98px) {\n  .controls-size__right {\n    margin-left: 0px;\n  }\n}\n.controls-size__right::after {\n  position: absolute;\n  left: 50%;\n  top: 50%;\n  transform: translate3d(-50%, -50%, 0) rotate(-90deg);\n  content: "";\n  width: 24px;\n  height: 24px;\n  background-color: var(--sizeSelectorColor);\n  -webkit-mask: url(content/images/caret.svg) no-repeat center;\n  mask: url(content/images/caret.svg) no-repeat center center;\n}\n.controls-size__select {\n  position: relative;\n  display: inline-block;\n}\n.controls-size__select::after {\n  position: absolute;\n  right: 10px;\n  top: 50%;\n  transform: translateY(-50%);\n  content: "";\n  width: 24px;\n  height: 24px;\n  background-color: var(--sizeSelectorColor);\n  -webkit-mask: url(content/images/caret.svg) no-repeat center;\n  mask: url(content/images/caret.svg) no-repeat center center;\n  pointer-events: none;\n}\n.controls-size__select select {\n  border: 1px solid var(--sizeSelectorBorder);\n  color: var(--sizeSelectorColor);\n  width: 230px;\n  left: 120px;\n  appearance: none;\n  -webkit-appearance: none;\n  padding: 10px 25px 10px 12px;\n  background: transparent;\n  outline: none;\n  z-index: 1;\n  border-radius: 0;\n}\n.controls-size__select select option {\n  background: var(--sizeSelectorBackground);\n}\n.controls-size__select select::-ms-expand {\n  display: none;\n}\n@media (max-width: 991.98px) {\n  .controls-size {\n    position: fixed;\n    top: 76px;\n    left: 50%;\n    transform: translateX(-50%);\n    z-index: 20;\n  }\n  .controls-size select, .controls-size p {\n    color: #403e3b;\n    border-color: #403e3b;\n  }\n  .controls-size p {\n    margin-bottom: 5px;\n  }\n  .controls-size__left::after, .controls-size__right::after, .controls-size__select::after {\n    background-color: #403e3b;\n  }\n  .controls-size__select select option {\n    background-color: #cecece;\n  }\n}\n\n/* radio-buttons */\n@media (max-width: 991.98px) {\n  .radio-buttons label span {\n    display: none;\n  }\n}\n\n.controls-group-divider {\n  margin-top: 25px;\n  padding-bottom: 25px;\n  border-bottom: 1px solid var(--dividerColor);\n}\n.controls-group {\n  margin-top: 25px;\n  padding-bottom: 25px;\n}\n.controls-flip-building {\n  display: flex;\n  margin-bottom: 20px;\n  gap: 8px;\n  justify-content: center;\n}\n.controls-flip-building .btn {\n  padding: 12.5px 20px;\n  display: flex;\n  align-items: center;\n  gap: 5px;\n  min-width: 130px;\n  justify-content: center;\n}\n.controls-windows__left label,\n.controls-windows__right label {\n  width: 100%;\n  max-width: 122px;\n}\n.controls-title {\n  font-style: normal;\n  font-weight: normal;\n  font-size: 17px;\n  line-height: 1.3;\n}\n.navigation-btn-container {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 10px;\n  height: 66px;\n  margin: 0 15px;\n  position: sticky;\n  bottom: 0;\n  left: 0;\n  right: 0;\n}\n.navigation-btn-container > button {\n  width: 50%;\n