form button:disabled,\n.overlay-dg a.disabled,\n.dialog-form a.disabled {\n    background-color: #989898;\n    cursor: not-allowed;\n}\n.dialog-form p {\n    line-height: 1.2;\n}\n.dialog-form select,\n.select,\n.borderless-input-container select {\n    background-image:\n        linear-gradient(45deg, transparent 50%, #000000 50%),\n        linear-gradient(135deg, #000000 50%, transparent 50%),\n        linear-gradient(to right, #ccc, #ccc);\n    background-position:\n        calc(100% - 20px) calc(1em + 3px),\n        calc(100% - 15px) calc(1em + 3px),\n        calc(100% - 2.5em) 0.7em;\n    background-size:\n        5px 5px,\n        5px 5px,\n        1px 1.5em;\n    background-repeat: no-repeat;\n    padding-right: 50px;\n    appearance: none;\n}\n\nbutton.quiet,\ntextarea.quiet,\ninput.quiet {\n    color: var(--color);\n    background-color: var(--headerer);\n}\nbutton.selected,\n.menu-thumb:active,\n.action-button:active,\n.overlay-dg button:active,\n.dialog-form button:active,\n.floating-toolbar button:active,\n.layers-controller button:first-child:active,\n.icon-button:active {\n    color: var(--buttonsActiveColor) !important;\n    background-color: var(--buttonsActiveBackround) !important;\n    outline: none;\n    box-shadow: none !important;\n}\nbutton.sm {\n    padding: 6px 5px;\n}\nbutton.fit {\n    width: 100%;\n}\n.button-group {\n    display: flex;\n    align-items: stretch;\n    gap: 8px;\n}\n.button-group > button {\n    flex: 1 1 0;\n    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.16);\n}\n\n.input-error {\n    color: #dc6a57;\n    font-size: 13px;\n    margin: 2px 0 0 0;\n    visibility: hidden;\n    min-height: 15px;\n}\n.dialog-form input[type="checkbox"] + .input-error {\n    margin: 10px 0 0 -35px;\n}\n\nbutton.close {\n    min-width: 36px;\n    font-size: 40px;\n    z-index: 100;\n    padding: 0 !important;\n    line-height: 34px;\n    height: 36px;\n}\n\n.dialog-form input:-webkit-autofill,\n.dialog-form input:-webkit-autofill:hover,\n.dialog-form