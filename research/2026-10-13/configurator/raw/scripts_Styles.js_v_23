ar(--sideBarFormColor);\n    margin-top: 10px;\n    border: 1px solid var(--sideBarFormBorderColor, var(--sideBarFormBackground));\n}\n.form__field {\n    margin-bottom: 10px;\n}\n.side-bar-form textarea,\n.side-bar-form input[type="text"],\n.side-bar-form input[type="email"],\n.side-bar-form input[type="tel"],\n.side-bar-form select {\n    background-color: var(--sideBarFormInputBackground);\n    color: var(--sideBarFormInputColor);\n    border: 1px solid var(--sideBarFormInputBorderColor, var(--sideBarFormInputBackground));\n    height: 34px;\n    width: 100%;\n    padding-left: 9px;\n    padding-right: 9px;\n}\n.side-bar-form ::placeholder {\n    color: var(--sideBarFormInputPlaceholderColor, var(--sideBarFormInputBackground));\n}\n.invalid-select-placeholder-color select:required:invalid {\n    color: var(--sideBarFormInputPlaceholderColor);\n}\n.side-bar-form textarea {\n    resize: vertical;\n    padding: 10px;\n    min-height: 50px;\n}\n.side-bar-form .submit-buttons {\n    display: flex;\n    gap: 5px;\n}\n.side-bar-form .submit-buttons button {\n    background: var(--sideBarFormButtonBackground);\n    height: var(--sideBarFormButtonHeight);\n    text-align: center;\n    color: var(--sideBarFormButtonColor);\n    border-radius: var(--sideBarFormButtonBorderRadius);\n    box-shadow: none;\n    border: none;\n    outline: none;\n    flex-grow: 1;\n    flex-basis: 0;\n}\n.form button:disabled,\n.side-bar-form button:disabled {\n    background-color: lightgray;\n    cursor: not-allowed;\n}\n.form__field-radios {\n    margin-bottom: 10px;\n}\n.form__field-radios input[type="radio"] {\n    margin-right: 5px;\n    display: inline-block;\n}\n.form__field-radios label {\n    margin-right: 15px;\n}\n.form__required {\n    border: 1px solid #790000 !important;\n}\n.form__error {\n    color: #790000;\n    font-size: 14px;\n    margin-top: 0;\n    margin-bottom: 0;\n}\n.form p,\n.side-bar-form p {\n    margin-bottom: 0;\n}\n.form a,\n.side-bar-form a {\n    color: var(--